# TopicSystem 生产环境变量模板（不得填入真实密钥后提交）
ENVIRONMENT="production"
JWT_SECRET="REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS"
DATABASE_URL="postgres://topic_app:REPLACE_WITH_PASSWORD@postgres:5432/topic"
DATABASE_READ_URL="postgres://topic_read:REPLACE_WITH_PASSWORD@postgres:5432/topic"
TS_DS_APIKEY="REPLACE_WITH_LLM_API_KEY"
API_ADDRESS="https://api.deepseek.com/v1"
API_MODEL="deepseek-chat"
EMBEDDING_API_KEY="REPLACE_WITH_EMBEDDING_API_KEY"
MILVUS_HOST="127.0.0.1"
MILVUS_PORT=19530
RABBITMQ_USER="topic_app"
RABBITMQ_PASSWORD="REPLACE_WITH_RABBITMQ_PASSWORD"
SMTP_USER="REPLACE_WITH_SMTP_USER"
SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
